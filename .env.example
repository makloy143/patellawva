# Copy to `.env.local` (local dev) or `.env.production` (server deploy).
# Vite loads these automatically; `npm run build` bakes the gate into dist/.

# IMPORTANT
# • The passphrase is inlined into browser JavaScript anyone can inspect.
#   For real secrecy use nginx Basic Auth / your host's access control.
# • Never commit a real passphrase — keep it only in gitignored .env files.
VITE_SITE_PASSWORD=

# Server example (/var/www/patellawva):
#   echo 'VITE_SITE_PASSWORD=your-passphrase' > .env.production
#   bash scripts/deploy-build.sh
